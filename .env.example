# Hugging Face Inference Providers — use your own token. Do NOT commit this file with a real token.
# Get a fine-grained token with "Make calls to Inference Providers" permission.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-20b:fastest
HF_TIMEOUT=50

# Only opt in if Docker Desktop is running and the code language image was pulled.
# Never expose this educational local code runner directly on the public internet.
JOBTRIAL_ENABLE_DOCKER=false
APP_ENV=development
